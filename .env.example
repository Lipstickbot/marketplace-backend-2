# Backend 2 only. Fill locally; never put real keys into Git.
SUPABASE_URL=https://qxzhrkchmzmfxvkpnbfr.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Prefer a current sb_secret_... key for the future trusted backend.
SUPABASE_SECRET_KEY=
# Optional legacy server key; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
OAUTH_REDIRECT_ORIGINS=http://localhost:3000,http://127.0.0.1:8001,https://keme-ai-platform.onrender.com
AUTH_TIMEOUT_SECONDS=15
AUTH_REQUESTS_PER_MINUTE=10

# Used in the later HTTP integration step.
ENGINE_URL=http://127.0.0.1:8002
ENGINE_JWT_SECRET=
ENGINE_JWT_AUDIENCE=ai-engine
ENGINE_JWT_ISSUER=marketplace-backend
ENGINE_JWT_TTL_SECONDS=300
ENGINE_TIMEOUT_SECONDS=180
RUNTIME_TIMEOUT_SECONDS=60

# Optional Gemini runtime for the built-in ARCHITECT mentor.
ARCHITECT_GEMINI_API_KEY=
ARCHITECT_GEMINI_MODEL=gemini-3.5-flash-lite

# Enable only for an approved live PayLink merchant.
PAYLINK_LIVE_ENABLED=false
PAYLINK_LIVE_SHOP_ID=
PAYLINK_LIVE_SECRET_KEY=
PAYLINK_NOTIFICATION_BASE=
